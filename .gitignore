# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment — never commit real Firebase credentials
.env
.env.local
.env.*.local
!.env.example

# Service account / admin credentials — NEVER commit.
# These grant full, rules-bypassing access to the Firebase project.
serviceAccountKey.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
*.pem
*.key

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel CLI local link + pulled env
.vercel
.env*
# Re-allow the committed template. This negation MUST stay below `.env*`,
# otherwise the later pattern wins and the template is ignored again.
!.env.example
